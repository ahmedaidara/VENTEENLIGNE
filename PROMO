<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin - Gestion des Promotions | DAKAR CHICKEN EXPRESS</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
      <script src="https://www.gstatic.com/firebasejs/8.10.0/firebase-app.js"></script>
    <script src="https://www.gstatic.com/firebasejs/8.10.0/firebase-firestore.js"></script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: linear-gradient(135deg, #f5f0e6 0%, #fff5e8 100%);
            font-family: 'Poppins', 'Segoe UI', sans-serif;
            min-height: 100vh;
        }

        /* Header */
        .header {
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
            color: white;
            padding: 20px;
            text-align: center;
            box-shadow: 0 5px 20px rgba(0,0,0,0.2);
        }

        .logo {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 15px;
            margin-bottom: 10px;
        }

        .logo-img {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            object-fit: cover;
            border: 3px solid #f5a623;
        }

        .logo h1 {
            font-size: 1.5rem;
            letter-spacing: 2px;
        }

        .logo span {
            color: #f5a623;
        }

        .slogan {
            font-size: 0.8rem;
            opacity: 0.8;
        }

        /* Container */
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
        }

        /* Cartes */
        .card {
            background: white;
            border-radius: 20px;
            padding: 25px;
            margin-bottom: 30px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        }

        .card-title {
            font-size: 1.5rem;
            color: #1a1a2e;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
            border-bottom: 3px solid #f5a623;
            padding-bottom: 10px;
        }

        /* Formulaire */
        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
            color: #333;
        }

        .form-group select,
        .form-group input {
            width: 100%;
            padding: 12px 15px;
            border: 2px solid #e0e0e0;
            border-radius: 10px;
            font-size: 1rem;
            transition: all 0.3s;
        }

        .form-group select:focus,
        .form-group input:focus {
            outline: none;
            border-color: #f5a623;
            box-shadow: 0 0 0 3px rgba(245,166,35,0.1);
        }

        /* Boutons */
        .btn {
            padding: 12px 25px;
            border: none;
            border-radius: 10px;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s;
            font-size: 1rem;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .btn-primary {
            background: linear-gradient(135deg, #10b981, #059669);
            color: white;
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(16,185,129,0.3);
        }

        .btn-danger {
            background: linear-gradient(135deg, #ef4444, #dc2626);
            color: white;
        }

        .btn-danger:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(239,68,68,0.3);
        }

        .btn-warning {
            background: linear-gradient(135deg, #f59e0b, #d97706);
            color: white;
        }

        .btn-warning:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(245,158,11,0.3);
        }

        .btn-secondary {
            background: linear-gradient(135deg, #6b7280, #4b5563);
            color: white;
        }

        .btn-secondary:hover {
            transform: translateY(-2px);
        }

        /* Tableau des promotions */
        .promos-table {
            width: 100%;
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th, td {
            padding: 15px;
            text-align: left;
            border-bottom: 1px solid #e0e0e0;
        }

        th {
            background: #f8f9fa;
            font-weight: 600;
            color: #1a1a2e;
        }

        tr:hover {
            background: #f8f9fa;
        }

        .product-cell {
            font-weight: 600;
            color: #1a1a2e;
        }

        .original-price {
            text-decoration: line-through;
            color: #999;
        }

        .promo-price {
            color: #ef4444;
            font-weight: bold;
            font-size: 1.1rem;
        }

        .discount-badge {
            background: #ef4444;
            color: white;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: bold;
            display: inline-block;
        }

        .btn-small {
            padding: 6px 12px;
            font-size: 0.8rem;
            margin: 0 3px;
        }

        /* Notification */
        .notification {
            position: fixed;
            bottom: 30px;
            right: 30px;
            background: #10b981;
            color: white;
            padding: 12px 24px;
            border-radius: 50px;
            z-index: 1000;
            display: none;
            animation: slideIn 0.3s ease;
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }

        .notification.error {
            background: #ef4444;
        }

        @keyframes slideIn {
            from {
                transform: translateX(100px);
                opacity: 0;
            }
            to {
                transform: translateX(0);
                opacity: 1;
            }
        }

        /* Stats */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .stat-card {
            background: linear-gradient(135deg, #f5a623, #e67e22);
            color: white;
            padding: 20px;
            border-radius: 15px;
            text-align: center;
        }

        .stat-number {
            font-size: 2rem;
            font-weight: bold;
        }

        .stat-label {
            font-size: 0.9rem;
            opacity: 0.9;
            margin-top: 5px;
        }

        /* Lien retour */
        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: #1a1a2e;
            color: white;
            padding: 10px 20px;
            border-radius: 10px;
            text-decoration: none;
            margin-bottom: 20px;
            transition: all 0.3s;
        }

        .back-link:hover {
            background: #f5a623;
            transform: translateX(-5px);
        }

        /* Footer */
        footer {
            text-align: center;
            padding: 30px;
            background: #1a1a2e;
            color: #888;
            margin-top: 50px;
        }

        @media (max-width: 768px) {
            th, td {
                padding: 10px;
                font-size: 0.8rem;
            }
            
            .btn-small {
                padding: 4px 8px;
                font-size: 0.7rem;
            }
        }
    </style>
</head>
<body>
    <div class="header">
        <div class="logo">
            <img src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ccircle cx='50' cy='50' r='45' fill='%23f5a623'/%3E%3Ctext x='50' y='67' text-anchor='middle' fill='white' font-size='40' font-weight='bold'%3EDC%3C/text%3E%3C/svg%3E" alt="Logo" class="logo-img">
            <h1>DAKAR <span>CHICKEN</span> EXPRESS</h1>
        </div>
        <div class="slogan">Administration - Gestion des promotions</div>
    </div>

    <div class="container">
        <a href="#" onclick="window.location.href=window.location.origin + '/index.html'; return false;" class="back-link" id="backLink">
            <i class="fas fa-arrow-left"></i> Retour à la boutique
        </a>

        <!-- Statistiques -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-number" id="totalProducts">0</div>
                <div class="stat-label">Total produits</div>
            </div>
            <div class="stat-card">
                <div class="stat-number" id="totalPromos">0</div>
                <div class="stat-label">Produits en promo</div>
            </div>
            <div class="stat-card">
                <div class="stat-number" id="avgDiscount">0%</div>
                <div class="stat-label">Remise moyenne</div>
            </div>
        </div>

        <!-- Formulaire ajout/modification promo -->
        <div class="card">
            <div class="card-title">
                <i class="fas fa-tag" style="color: #f5a623;"></i>
                <span>Ajouter / Modifier une promotion</span>
            </div>
            <div class="form-group">
                <label><i class="fas fa-drumstick-bite"></i> Choisir le produit</label>
                <select id="productSelect">
                    <option value="">-- Sélectionnez un produit --</option>
                </select>
            </div>
            <div class="form-group">
                <label><i class="fas fa-money-bill-wave"></i> Prix promotionnel (F CFA)</label>
                <input type="number" id="promoPrice" placeholder="Ex: 1700" step="100">
            </div>
            <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                <button class="btn btn-primary" onclick="savePromotion()">
                    <i class="fas fa-save"></i> Enregistrer la promotion
                </button>
                <button class="btn btn-danger" id="deletePromoBtn" onclick="deletePromotion()" style="display: none;">
                    <i class="fas fa-trash"></i> Supprimer cette promotion
                </button>
                <button class="btn btn-secondary" onclick="clearForm()">
                    <i class="fas fa-eraser"></i> Effacer
                </button>
            </div>
        </div>

        <!-- Liste des promotions actives -->
        <div class="card">
            <div class="card-title">
                <i class="fas fa-list" style="color: #f5a623;"></i>
                <span>Promotions actives</span>
                <button class="btn btn-warning btn-small" onclick="exportPromotions()" style="margin-left: auto; padding: 5px 12px;">
                    <i class="fas fa-download"></i> Exporter
                </button>
            </div>
            <div class="promos-table">
                <table id="promosTable">
                    <thead>
                        <tr>
                            <th>Produit</th>
                            <th>Poids</th>
                            <th>Prix original</th>
                            <th>Prix promo</th>
                            <th>Remise</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="promosTableBody">
                        <tr>
                            <td colspan="6" style="text-align: center;">Aucune promotion active</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Actions rapides -->
        <div class="card">
            <div class="card-title">
                <i class="fas fa-bolt" style="color: #f5a623;"></i>
                <span>Actions rapides</span>
            </div>
            <div style="display: flex; gap: 15px; flex-wrap: wrap;">
                <button class="btn btn-warning" onclick="clearAllPromotions()">
                    <i class="fas fa-trash-alt"></i> Supprimer toutes les promos
                </button>
                <button class="btn btn-primary" onclick="loadSamplePromotions()">
                    <i class="fas fa-flask"></i> Charger des exemples
                </button>
                <button class="btn btn-secondary" onclick="refreshDisplay()">
                    <i class="fas fa-sync-alt"></i> Actualiser
                </button>
            </div>
        </div>
    </div>

    <footer>
        <p>&copy; 2026 DAKAR CHICKEN EXPRESS - Administration</p>
    </footer>

    <div id="notification" class="notification"></div>

   <script>
    // ========== CONFIGURATION FIREBASE ==========
    const firebaseConfig = {
        apiKey: "AIzaSyAAQ9G3w94aM7iGc_ufHMzdCvrwzzEzlhI",
        authDomain: "poulailler-3515e.firebaseapp.com",
        projectId: "poulailler-3515e",
        storageBucket: "poulailler-3515e.firebasestorage.app",
        messagingSenderId: "482441929117",
        appId: "1:482441929117:web:7970df401b0125560acf74"
    };
    firebase.initializeApp(firebaseConfig);
    const db = firebase.firestore();

    // ========== CATALOGUE PRODUITS ==========
    const CATALOGUE = [
        { id: 1, name: "Très petits (1.0-1.1kg)", weight: "1.0 - 1.1 kg", price: 2000 },
        { id: 2, name: "Petits (1.2 kg)", weight: "1.2 kg", price: 2500 },
        { id: 3, name: "Moyens-petits (1.3 - 1.4 kg)", weight: "1.3 - 1.4 kg", price: 3000 },
        { id: 4, name: "Moyens (1.5 - 1.6 kg)", weight: "1.5 - 1.6 kg", price: 3300 },
        { id: 5, name: "Moyens-grands (1.7 - 1.9 kg)", weight: "1.7 - 1.9 kg", price: 3500 },
        { id: 6, name: "Grands (2.0 kg)", weight: "2.0 kg", price: 3700 },
        { id: 7, name: "Très grands (2.1 - 2.3 kg)", weight: "2.1 - 2.3 kg", price: 4000 },
        { id: 8, name: "Géants (+2.4 kg)", weight: "+2.4 kg", price: 4500 }
    ];

    // Stockage des promotions
    let promotions = {};

    // ========== CHARGEMENT DEPUIS FIREBASE ==========
    async function loadPromotionsFromFirebase() {
        try {
            const docRef = db.collection('promotions').doc('active_promos');
            const doc = await docRef.get();
            if (doc.exists) {
                promotions = doc.data().promotions || {};
            } else {
                promotions = {};
                await savePromotionsToFirebase();
            }
            refreshDisplay();
        } catch (error) {
            console.error('Erreur chargement:', error);
            showNotification('Erreur de connexion à Firebase', 'error');
            // Fallback sur localStorage
            const saved = localStorage.getItem('dakar_chicken_promos_backup');
            if (saved) promotions = JSON.parse(saved);
            refreshDisplay();
        }
    }

    // ========== SAUVEGARDE VERS FIREBASE ==========
    async function savePromotionsToFirebase() {
        try {
            const docRef = db.collection('promotions').doc('active_promos');
            await docRef.set({
                promotions: promotions,
                lastUpdated: firebase.firestore.FieldValue.serverTimestamp(),
                updatedBy: "admin"
            });
            // Backup local
            localStorage.setItem('dakar_chicken_promos_backup', JSON.stringify(promotions));
            // Aussi sauvegarder dans localStorage principal
            localStorage.setItem('dakar_chicken_promos', JSON.stringify(promotions));
        } catch (error) {
            console.error('Erreur sauvegarde:', error);
            showNotification('Erreur de sauvegarde sur le serveur', 'error');
        }
    }

    // ========== SUIVI EN TEMPS RÉEL ==========
    function listenToPromotions() {
        db.collection('promotions').doc('active_promos')
            .onSnapshot((doc) => {
                if (doc.exists) {
                    promotions = doc.data().promotions || {};
                    refreshDisplay();
                }
            }, (error) => {
                console.error('Erreur écoute:', error);
            });
    }

    // ========== AFFICHAGE ==========
    function refreshDisplay() {
        populateProductSelect();
        renderPromosTable();
        updateStats();
    }

    function populateProductSelect() {
        const select = document.getElementById('productSelect');
        select.innerHTML = '<option value="">-- Sélectionnez un produit --</option>';
        
        CATALOGUE.forEach(product => {
            const option = document.createElement('option');
            option.value = product.id;
            const hasPromo = promotions[product.id];
            const promoText = hasPromo ? ` [PROMO: ${promotions[product.id].promoPrice} F]` : '';
            option.textContent = `${product.name} - ${product.price} F${promoText}`;
            select.appendChild(option);
        });
    }

    function renderPromosTable() {
        const tbody = document.getElementById('promosTableBody');
        const activePromos = Object.keys(promotions).filter(id => promotions[id] && promotions[id].promoPrice > 0);
        
        if (activePromos.length === 0) {
            tbody.innerHTML = '<tr><td colspan="6" style="text-align: center;">Aucune promotion active</td></tr>';
            return;
        }
        
        tbody.innerHTML = '';
        activePromos.forEach(productId => {
            const product = CATALOGUE.find(p => p.id == productId);
            if (!product) return;
            
            const promo = promotions[productId];
            const discountPercent = Math.round((1 - promo.promoPrice / product.price) * 100);
            
            const row = document.createElement('tr');
            row.innerHTML = `
                <td class="product-cell">${product.name}</td>
                <td>${product.weight}</td>
                <td><span class="original-price">${product.price.toLocaleString('fr-FR')} F</span></td>
                <td><span class="promo-price">${promo.promoPrice.toLocaleString('fr-FR')} F</span></td>
                <td><span class="discount-badge">-${discountPercent}%</span></td>
                <td>
                    <button class="btn-small btn-warning" onclick="editPromotion(${product.id})">
                        <i class="fas fa-edit"></i> Modifier
                    </button>
                    <button class="btn-small btn-danger" onclick="deletePromotionById(${product.id})">
                        <i class="fas fa-trash"></i> Supprimer
                    </button>
                </td>
            `;
            tbody.appendChild(row);
        });
    }

    function updateStats() {
        const totalProducts = CATALOGUE.length;
        const activePromos = Object.keys(promotions).filter(id => promotions[id] && promotions[id].promoPrice > 0).length;
        
        let totalDiscount = 0;
        Object.keys(promotions).forEach(id => {
            const product = CATALOGUE.find(p => p.id == id);
            if (product && promotions[id]) {
                totalDiscount += (1 - promotions[id].promoPrice / product.price) * 100;
            }
        });
        const avgDiscount = activePromos > 0 ? Math.round(totalDiscount / activePromos) : 0;
        
        document.getElementById('totalProducts').textContent = totalProducts;
        document.getElementById('totalPromos').textContent = activePromos;
        document.getElementById('avgDiscount').textContent = avgDiscount + '%';
    }

    // ========== GESTION DES PROMOTIONS ==========
    async function savePromotion() {
        const productId = parseInt(document.getElementById('productSelect').value);
        const promoPrice = parseInt(document.getElementById('promoPrice').value);
        
        if (!productId) {
            showNotification('Veuillez choisir un produit', 'error');
            return;
        }
        
        if (!promoPrice || promoPrice <= 0) {
            showNotification('Veuillez entrer un prix valide (supérieur à 0)', 'error');
            return;
        }
        
        const product = CATALOGUE.find(p => p.id === productId);
        if (promoPrice >= product.price) {
            showNotification(`Le prix promo doit être inférieur au prix original (${product.price} F)`, 'error');
            return;
        }
        
        promotions[productId] = {
            originalPrice: product.price,
            promoPrice: promoPrice,
            dateAdded: new Date().toISOString(),
            discountPercent: Math.round((1 - promoPrice / product.price) * 100)
        };
        
        await savePromotionsToFirebase();
        showNotification(`✅ Promotion enregistrée : ${product.name} à ${promoPrice.toLocaleString('fr-FR')} F (visible sur tous les appareils)`, 'success');
        clearForm();
    }

    function deletePromotion() {
        const productId = parseInt(document.getElementById('productSelect').value);
        if (!productId) return;
        deletePromotionById(productId);
    }

    async function deletePromotionById(productId) {
        const product = CATALOGUE.find(p => p.id === productId);
        if (product && promotions[productId]) {
            delete promotions[productId];
            await savePromotionsToFirebase();
            showNotification(`✅ Promotion supprimée pour : ${product.name} (mis à jour sur tous les appareils)`, 'success');
            clearForm();
        }
    }

    function editPromotion(productId) {
        const product = CATALOGUE.find(p => p.id === productId);
        if (product && promotions[productId]) {
            const select = document.getElementById('productSelect');
            select.value = productId;
            document.getElementById('promoPrice').value = promotions[productId].promoPrice;
            document.getElementById('deletePromoBtn').style.display = 'inline-flex';
            
            document.querySelector('.card').scrollIntoView({ behavior: 'smooth' });
            showNotification(`Modification de la promotion pour : ${product.name}`, 'success');
        }
    }

    function clearForm() {
        document.getElementById('productSelect').value = '';
        document.getElementById('promoPrice').value = '';
        document.getElementById('deletePromoBtn').style.display = 'none';
    }

    async function clearAllPromotions() {
        if (confirm('⚠️ Êtes-vous sûr de vouloir supprimer TOUTES les promotions ? Cette action est irréversible.')) {
            promotions = {};
            await savePromotionsToFirebase();
            showNotification('✅ Toutes les promotions ont été supprimées (mis à jour sur tous les appareils)', 'success');
            clearForm();
        }
    }

    function loadSamplePromotions() {
        promotions = {
            1: { originalPrice: 2000, promoPrice: 1700, dateAdded: new Date().toISOString(), discountPercent: 15 },
            3: { originalPrice: 3000, promoPrice: 2500, dateAdded: new Date().toISOString(), discountPercent: 17 },
            5: { originalPrice: 3500, promoPrice: 3000, dateAdded: new Date().toISOString(), discountPercent: 14 },
            7: { originalPrice: 4000, promoPrice: 3500, dateAdded: new Date().toISOString(), discountPercent: 13 }
        };
        savePromotionsToFirebase();
        showNotification('✅ Exemples de promotions chargés !', 'success');
        clearForm();
    }

    function exportPromotions() {
        const activePromos = Object.keys(promotions).filter(id => promotions[id] && promotions[id].promoPrice > 0);
        if (activePromos.length === 0) {
            showNotification('Aucune promotion à exporter', 'error');
            return;
        }
        
        let exportText = "=== PROMOTIONS DAKAR CHICKEN EXPRESS ===\n";
        exportText += `Généré le : ${new Date().toLocaleString('fr-FR')}\n\n`;
        
        activePromos.forEach(id => {
            const product = CATALOGUE.find(p => p.id == id);
            const promo = promotions[id];
            if (product) {
                exportText += `Produit: ${product.name}\n`;
                exportText += `Poids: ${product.weight}\n`;
                exportText += `Prix original: ${product.price.toLocaleString('fr-FR')} F CFA\n`;
                exportText += `Prix promo: ${promo.promoPrice.toLocaleString('fr-FR')} F CFA\n`;
                exportText += `Remise: -${promo.discountPercent}%\n`;
                exportText += `-----------------------------------\n`;
            }
        });
        
        const blob = new Blob([exportText], { type: 'text/plain' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `promotions_${new Date().toISOString().slice(0,19)}.txt`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
        
        showNotification('✅ Exportation terminée', 'success');
    }

    function showNotification(message, type = 'success') {
        const notif = document.getElementById('notification');
        notif.textContent = message;
        notif.className = 'notification';
        if (type === 'error') {
            notif.classList.add('error');
        }
        notif.style.display = 'block';
        setTimeout(() => {
            notif.style.display = 'none';
        }, 3000);
    }

    function detectBackLink() {
        const backLink = document.getElementById('backLink');
        const currentPath = window.location.pathname;
        const basePath = currentPath.substring(0, currentPath.lastIndexOf('/') + 1);
        backLink.href = basePath + 'index.html';
    }

    // ========== INITIALISATION ==========
    document.addEventListener('DOMContentLoaded', async () => {
        detectBackLink();
        await loadPromotionsFromFirebase();
        listenToPromotions(); // Écoute les changements en temps réel
        
        document.getElementById('productSelect').addEventListener('change', function() {
            const productId = parseInt(this.value);
            if (productId && promotions[productId]) {
                document.getElementById('promoPrice').value = promotions[productId].promoPrice;
                document.getElementById('deletePromoBtn').style.display = 'inline-flex';
            } else {
                document.getElementById('promoPrice').value = '';
                document.getElementById('deletePromoBtn').style.display = 'none';
            }
        });
    });
</script>
</body>
</html> 
